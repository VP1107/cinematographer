  "services": [
    {
      "id": "cinematography",
      "name": "Cinematography",
      "shortDesc": "Narrative-driven visual language for features, OTT, and indie films.",
      "longDesc": "From intimate indie dramas to large-scale productions, I craft images that serve the story first. Fluent in anamorphic, spherical, and digital acquisition. Experienced with ARRI, RED, and Sony systems across varied Indian locations — from Himalayan exteriors to the dense visual grammar of Indian city streets.",
      "icon": "camera",
      "accent": "saffron"
    },
    {
      "id": "commercial",
      "name": "Commercial Filmmaking",
      "shortDesc": "Brand films and campaigns that feel cinematic, not corporate.",
      "longDesc": "Working with agencies and direct-to-brand clients across FMCG, fashion, luxury, and technology. Every commercial brief is treated as a short film brief — concept, lighting, movement, and edit work in harmony to create ads that audiences actually want to watch.",
      "icon": "film",
      "accent": "crimson"
    },
    {
      "id": "music-videos",
      "name": "Music Videos",
      "shortDesc": "Visuals that amplify the emotion of the track — not just illustrate it.",
      "longDesc": "Extensive work across Bollywood, Indie Hindi, Tamil, and fusion genres. Comfortable directing and DPing simultaneously for budget-conscious productions, or leading larger crews for label projects. Strong aesthetic instinct for colour, movement, and the precise moment to cut.",
      "icon": "music",
      "accent": "teal"
    },
    {
      "id": "short-films",
      "name": "Short Films",
      "shortDesc": "Festival-ready short film cinematography — intimate, precise, resonant.",
      "longDesc": "Multiple selections at MAMI, IFFK, and international festivals. I work closely with debut directors to find the visual language of their story without over-designing it. Natural light, available locations, and disciplined prep are always the starting point.",
      "icon": "clapperboard",
      "accent": "saffron"
    },
    {
      "id": "creative-direction",
      "name": "Creative Direction",
      "shortDesc": "End-to-end visual concepting for campaigns, lookbooks, and digital content.",
      "longDesc": "Beyond the camera — mood boarding, reference curation, location scouting, wardrobe palette direction, and post-grade supervision. I help brands and artists develop a coherent visual identity that travels across formats.",
      "icon": "compass",
      "accent": "crimson"
    },
    {
      "id": "advertisement",
      "name": "Advertisement",
      "shortDesc": "High-impact visual narratives crafted specifically for brands, products, and advertising campaigns.",
      "longDesc": "Delivering visually striking advertisement campaigns that capture the core essence of a brand. I specialize in fast-paced production environments, utilizing dynamic lighting and bold camera movements to create engaging spots for both digital and broadcast platforms.",
      "icon": "megaphone",
      "accent": "teal"
    }
  ],
